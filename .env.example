# ShopSphere environment configuration
# Copy this file to ".env" and fill in your real values.
# These map to ${VAR} placeholders in application.properties.
# (To actually load a .env into the process you can use an env loader or set
#  these as real OS/IDE environment variables / IntelliJ run-config env vars.)

# ----- Database -----
DB_URL=jdbc:mysql://localhost:3306/shopsphere?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me

# ----- JPA -----
# Use "validate" (with Flyway) or "none" in production; "update" only for dev.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ----- Server -----
SERVER_PORT=8080

# ----- JWT (MUST be long & random in production) -----
JWT_SECRET=replace_with_a_long_random_64_char_minimum_secret_value_here_xxxxxxxxxx
JWT_EXPIRATION_MS=86400000

# ----- CORS (comma-separated frontend origins) -----
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ===== To be added in later phases (placeholders) =====
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
